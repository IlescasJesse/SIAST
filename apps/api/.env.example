# ── Seguridad — OBLIGATORIAS (servidor no arranca sin estas) ────────────────
# JWT secret — mínimo 32 caracteres recomendado
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres

# CORS origins — comma-separated
# Desarrollo: incluir web (5173) + visor 3D (5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Producción: reemplazar con el dominio real
# CORS_ORIGINS=https://tu-dominio.com,http://localhost:5173

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5101
NODE_ENV=development
# URL pública del frontend — usada en links de notificaciones (correo/WhatsApp).
FRONTEND_URL=http://localhost:5173

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=mysql://root:@localhost:3306/siast

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
# Expiración específica del token de empleado (RFC). Cae a JWT_EXPIRES_IN si se omite.
EMPLEADO_JWT_EXPIRES_IN=8h

# ── SIRH (sincronización de empleados desde el sistema de RH) ───────────────────
# Activa la integración real. En false se usa el mapeo/mock local.
SIRH_ENABLED=false
# Base del servicio SIRH y endpoints. OJO: la variable es SIRH_BASE_URL (no SIRH_URL).
SIRH_BASE_URL=http://localhost:3000
SIRH_LOGIN_ENDPOINT=/api/auth/login
# Credenciales de la cuenta de servicio que SIAST usa para autenticarse contra SIRH.
SIRH_SERVICE_USER=
SIRH_SERVICE_PASS=

# ── WhatsApp (canal primario de OTP) ────────────────────────────────────────────
# WA_ENABLED=false → no inicia el cliente; los OTP salen por consola (solo en dev).
# WA_ENABLED=true
# Cambiar este valor fuerza una sesión de WhatsApp nueva (re-escanear QR).
# WA_SESSION_ID=siast-v1
# Ruta a un Chrome/Chromium concreto si el autodetect no lo encuentra.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WA_HEADLESS=true

# ── Correo (canal alterno de OTP y notificaciones) ─────────────────────────────
# Sin configurar → modo CONSOLA en dev (el código se imprime en el log del servidor).
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=notificaciones@finanzasoaxaca.gob.mx
# MAIL_PASS=
# MAIL_FROM=SIAST <notificaciones@finanzasoaxaca.gob.mx>

# ── Fase de pruebas ─────────────────────────────────────────────────────────────
# true → el OTP se devuelve en la respuesta y se muestra en LoginPage (y un fallo de
# correo/WhatsApp no bloquea el login). ⚠️ APAGAR (false) antes de producción real.
OTP_MOSTRAR_EN_UI=false
